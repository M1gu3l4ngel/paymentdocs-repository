---
import { getCollection } from "astro:content";
import CopyEmail from "../components/CopyEmail.astro";
import DocumentCard from "../components/DocumentCard.astro";
import Icon from "../components/Icon.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const documents = (await getCollection("documents")).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
	title="Documents"
	description="The documents Stout needs from subcontractors and suppliers to process payments: what each one is, what it must include and where to send it."
>
	<section class="hero">
		<div class="container hero__inner">
			<p class="eyebrow">Subcontractors and suppliers</p>
			<h1>The documents we need to process your payment</h1>
			<p class="hero__lead">
				What each document is, what it must include and where to send it. Complete documents keep
				your pay application moving.
			</p>
			<CopyEmail email="documents@stoutllc.com" />
		</div>
	</section>

	<section class="container section" aria-labelledby="documents-heading">
		<div class="section__head">
			<h2 id="documents-heading">Required documents</h2>
			<label class="search">
				<Icon name="search" size={18} />
				<span class="visually-hidden">Filter documents</span>
				<input type="search" placeholder="Filter documents" data-doc-filter autocomplete="off" />
			</label>
		</div>
		<ul class="doc-grid" data-doc-list>
			{documents.map((document) => (
				<DocumentCard document={document} />
			))}
		</ul>
		<p class="empty-state" data-doc-empty hidden>
			No document matches your search.
		</p>
	</section>
</BaseLayout>

<script>
	const input = document.querySelector<HTMLInputElement>("[data-doc-filter]");
	const cards = document.querySelectorAll<HTMLElement>("[data-doc-list] [data-search]");
	const empty = document.querySelector<HTMLElement>("[data-doc-empty]");

	input?.addEventListener("input", () => {
		const query = input.value.trim().toLowerCase();
		let visible = 0;
		for (const card of cards) {
			const matches = (card.dataset["search"] ?? "").includes(query);
			card.hidden = !matches;
			if (matches) visible += 1;
		}
		if (empty) empty.hidden = visible > 0;
	});
</script>
