root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 2

# Two trailing spaces in Markdown are a forced line break.
[*.md]
trim_trailing_whitespace = false

# The YAML spec forbids tabs for indentation.
[*.{yml,yaml}]
indent_style = space
